#* @vtlvariable name="esc" type="org.apache.velocity.tools.generic.EscapeTool" *#
#* @vtlvariable name="study" type="io.redlink.more.data.model.Study" *#
#* @vtlvariable name="registrationUrl" type="java.lang.String" *#
#* @vtlvariable name="token" type="java.lang.String" *#
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <title>$esc.html($study.title())</title>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.js"></script>
        <style>
            body {
                font-family: -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif, Apple Color Emoji, Segoe UI Emoji, Segoe UI Symbol;
                color: #707070;
                font-size: 1rem;
                margin: 30px 40px;
                text-align: center;
                display: flex;
                justify-content: center;
                align-items: center;
                flex-direction: column;
            }
            h1 {
                font-size: 1.75rem;
                color: #6E8FAC;
                font-weight: 600;
                margin: 0 0 1rem;
            }
            #qrcode {
                margin: 10px 0;
                display: flex;
                justify-content: center;
            }
            a {
                color: #6E8FAC;
                &:hover {
                    color: #63819b;
                }
            }

            h2 {
                color: #5a5a5a;
                font-size: 1.25rem;
                font-weight: 600;
                margin-bottom: 0;
            }

            hr {
                margin: 1.5rem 0;
            }

            .bold {
                font-weight: 600;
            }

            .storeBadges {
                display: flex;
                flex-direction: row;
                justify-content: center;
                gap: 10px;

                img {
                    height: 50px;
                    width: auto;
                    margin: 10px 0;
                }
            }

            #copySection {
                h2 {
                    margin-bottom: 0.8rem;
                }

                #copyArea {
                    display: flex;
                    justify-items: stretch;
                    flex-direction: column;
                    gap: 0.2rem;

                    .copyItem {
                        display: flex;
                        flex-direction: row;
                        justify-content: space-between;
                        align-items: center;

                        button {
                            font-size: 1.5rem;
                            border: 1px solid #6e8fac;
                            padding: 0 5px;
                            color: white;
                            background-color: #6e8fac;
                            border-radius: 4px;
                            cursor: pointer;
                        }
                    }
                }
            }

            .flash {
                animation: flashFade 0.6s ease;
            }

            @keyframes flashFade {
                0% { background-color: #b7c7d6 }
                50% { background-color: transparent; }
                100% { background-color: #b7c7d6 }
            }

            @media (max-width: 480px) {
                h1 {
                    font-size: 1.5rem;
                }
                h2 {
                    margin: 20px 0 10px;
                }
                .getApp {
                    .storeBadges {
                        flex-direction: column;
                        gap: 5px;

                        img {
                            margin: 0;
                        }
                    }
                }
            }
        </style>
    </head>
<body>
    <h1>Sign-Up to $esc.html($study.title())</h1>
    <div>
        <div>Scan the QR-Code to join the Study</div>
        <div id="qrcode"></div>
        <div>
            <a href="$registrationUrl" target="_blank">$registrationUrl</a>
        </div>

        <hr />

        <div id="copySection">
            <h2>Copy your registration information</h2>
            <div id="copyArea">
                <div class="copyItem">
                    <div>
                        <span class="bold">Token:</span> <span id="token"></span>
                    </div>
                    <button onClick="copyToClipboard('token')">&#10697;</button>
                </div>
                <div class="copyItem">
                    <div>
                        <span class="bold">Endpoint:</span> <span id="endpoint"></span>
                    </div>
                    <button onClick="copyToClipboard('endpoint')">&#10697;</button>
                </div>
            </div>
        </div>

        <hr />

        <div class="getApp">
            <h2>Don't have the App yet? Get it here:</h2>
            <div class="storeBadges">
                <div>
                    <a href="https://play.google.com/store/apps/details?id=ac.at.lbg.dhp.more" target="_blank">
                        <img src="data:image/png;base64," alt="Get it from Play Store" />
                    </a>
                </div>
                <div>
                    <a href="https://apps.apple.com/us/app/more-app/id6450769124" target="_blank">
                        <img src="data:image/svg+xml;base64," alt="Get it from App Store" />
                    </a>
                </div>
            </div>
        </div>
    </div>

<script type="text/javascript">
    let token = "";
    let endpoint = "";

    function generate(content) {
        let qrCodeContainer = document.getElementById('qrcode');
        qrCodeContainer.innerHTML = '';
        new QRCode(qrCodeContainer, {
            text: content,
            width: 180, //128
            height: 180,
            colorDark: "#000000",
            colorLight: "#ffffff",
            correctLevel: QRCode.CorrectLevel.H
        });
    }

    function getTokenAndEndpoint(registrationUrl) {
        endpoint = registrationUrl.split("signup?")[0] || "";

        token = registrationUrl.split("token=").pop();
        if (token && token !== registrationUrl) {
            token = token.split("&")[0] || "";
        }

        document.getElementById("endpoint").textContent = endpoint;
        document.getElementById("token").textContent = token;
    }

    function copyToClipboard(type) {
        const copyValue = type === 'token' ? token : endpoint;
        navigator.clipboard.writeText(copyValue)
                .then(() => {
                    const el = document.getElementById(type);
                    flashElement(el);
                })
                .catch(err => console.error("Copy failed: ", err));
    }

    function flashElement(element) {
        element.classList.add("flash");
        setTimeout(() => {
            element.classList.remove("flash");
        }, 600);
    }

    getTokenAndEndpoint("$esc.javascript($registrationUrl)");
    generate("$esc.javascript($registrationUrl)");
</script>
</body>
</html>